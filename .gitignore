models/*.pt
models/*.pth
models/*.ckpt                      # trained checkpoints (gitignored; bridge falls back to seed-42 init)
dashboard/*.local*                 # local-only dashboard overrides

# Jupyter Notebook checkpoints
.ipynb_checkpoints

# OS / Editor
.DS_Store
Thumbs.db
